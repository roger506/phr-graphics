    "html": "<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><style>\n@font-face{font-family:'Lora';src:url('../../assets/fonts/Lora-Variable.ttf');font-weight:100 900;font-style:normal;font-display:block}\n@font-face{font-family:'Lora';src:url('../../assets/fonts/Lora-Italic-Variable.ttf');font-weight:100 900;font-style:italic;font-display:block}\n@font-face{font-family:'GFS Baskerville';src:url('../../assets/fonts/GFSBaskerville.otf');font-weight:400;font-style:normal;font-display:block}\n@font-face{font-family:'Caladea';src:url('../../assets/fonts/Caladea-Regular.ttf');font-weight:400;font-style:normal;font-display:block}\n@font-face{font-family:'Caladea';src:url('../../assets/fonts/Caladea-Bold.ttf');font-weight:700;font-style:normal;font-display:block}\n@font-face{font-family:'Caladea';src:url('../../assets/fonts/Caladea-Italic.ttf');font-weight:400;font-style:italic;font-display:block}\n@font-face{font-family:'DejaVu Sans Mono';src:url('../../assets/fonts/DejaVuSansMono.ttf');font-weight:400;font-style:normal;font-display:block}\n@font-face{font-family:'DejaVu Sans Mono';src:url('../../assets/fonts/DejaVuSansMono-Bold.ttf');font-weight:700;font-style:normal;font-display:block}\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{width:1080px;height:1920px;overflow:hidden}\n  body{font-family:\"Caladea\",\"Liberation Serif\",Georgia,serif;color:var(--text,#f5f1e8);\n    display:flex;flex-direction:column;align-items:center;justify-content:center;\n    padding:120px 90px;text-align:center;background:var(--bg,#0d1f33)}\n  #kick{font-family:\"Liberation Sans\",Arial,sans-serif;font-size:30px;letter-spacing:8px;\n    font-weight:700;text-transform:uppercase;color:var(--kick,#c9a24b);margin-bottom:52px;opacity:0}\n  #head{font-size:126px;line-height:1.04;font-weight:700;opacity:0}\n  #head .acc{color:var(--acc,#d8b45a)}\n  #sub{font-style:italic;font-size:54px;color:var(--sub,#cbb98f);margin-top:36px;opacity:0}\n  #stats{display:flex;gap:34px;margin-top:60px;opacity:0;width:100%;justify-content:center}\n  .stat{flex:1;max-width:300px;background:rgba(255,255,255,.09);\n    border:1px solid rgba(255,255,255,.22);border-radius:22px;padding:32px 24px 28px}\n  .stat .n{font-size:100px;font-weight:700;color:var(--text,#fff);line-height:1}\n  .stat .l{font-family:\"Liberation Sans\",Arial,sans-serif;font-size:22px;line-height:1.28;\n    letter-spacing:.2px;color:var(--kick,#c9a24b);margin-top:16px}\n  #take{font-style:italic;font-size:62px;color:var(--acc,#e7cf93);margin-top:70px;max-width:840px;line-height:1.18;opacity:0}\n  #logo{height:156px;object-fit:contain;margin-top:60px;opacity:0}\n  #tag{font-family:\"Caladea\",\"Liberation Serif\",Georgia,serif;font-style:italic;font-size:34px;color:var(--acc,#e7cf93);margin-top:24px;opacity:0}\n  #foot{font-family:\"Liberation Sans\",Arial,sans-serif;font-size:28px;color:var(--foot,#93a4b8);margin-top:22px;opacity:0}\n</style></head><body>\n  <div id=\"kick\"></div>\n  <div id=\"head\"></div>\n  <div id=\"sub\"></div>\n  <div id=\"stats\"></div>\n  <div id=\"take\"></div>\n  <img id=\"logo\">\n  <div id=\"tag\"></div>\n  <div id=\"foot\"></div>\n<script>\nwindow.DATA = {\n  \"kicker\":\"Broward County · Property Taxes\",\n  \"headline\":\"Your November ballot\\njust got rewritten.\\n[[$250,000 by 2028.]]\",\n  \"takeaway\":\"The fine print matters more than the title.\",\n  \"stats\":[\n    {\"n\":\"$150K\",\"label\":\"homestead exemption starting 2027\"},\n    {\"n\":\"$250K\",\"label\":\"homestead exemption by 2028\"},\n    {\"n\":\"60%\",\"label\":\"voter approval required to pass\"}\n  ],\n  \"attribution\":\"Roger Averbuj, Broker | Prestige Heritage Realty | (954) 663-8461\",\n  \"palette\":{\"bg\":\"#0e4f4a\",\"text\":\"#ffffff\",\"acc\":\"#e7cf93\",\"kick\":\"#9fe3d3\",\"sub\":\"#cfe9e2\",\"foot\":\"#cfe9e2\",\"logo\":\"../../assets/phr_logo_white.png\"}\n};\nconst D=window.DATA, P=D.palette||{};\nfunction esc(s){return String(s==null?\"\":s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\");}\nfunction hl(s){return esc(s).replace(/\\n/g,\"<br>\").replace(/\\[\\[(.+?)\\]\\]/g,'<span class=\"acc\">$1</span>');}\nfunction plain(s){return String(s==null?\"\":s).replace(/<\\/?[^>]+>/g,\"\");}\nfunction id(x){return document.getElementById(x);}\nvar rs=document.documentElement.style;\n[\"bg\",\"text\",\"acc\",\"kick\",\"sub\",\"foot\"].forEach(function(k){if(P[k])rs.setProperty(\"--\"+k,P[k]);});\nid(\"kick\").textContent=D.kicker||\"\";\nid(\"head\").innerHTML=hl(D.headline||\"\");\nid(\"sub\").textContent=D.sub||\"\";\nid(\"take\").innerHTML=hl(D.takeaway||\"\");\nid(\"foot\").textContent=plain(D.attribution||\"\");\nid(\"logo\").src=P.logo||\"../../assets/phr_logo_white.png\";\nid(\"tag\").textContent=D.tagline||\"Straight answers. Deep roots.\";\nid(\"stats\").innerHTML=(D.stats||[]).slice(0,3).map(function(s){\n  return '<div class=\"stat\"><div class=\"n\">'+esc(s.n)+'</div><div class=\"l\">'+esc(s.label||s.short||\"\")+'</div></div>';}).join(\"\");\nif(!D.sub)id(\"sub\").style.display=\"none\";\nvar T=0;\nfunction cl(x,a,b){return Math.max(a,Math.min(b,x));}\nfunction eo(p){return 1-Math.pow(1-p,3);}\nfunction rev(el,start,dur,dy){var p=eo(cl((T-start)/dur,0,1));el.style.opacity=p;\n  el.style.transform=\"translateY(\"+((1-p)*(dy==null?46:dy))+\"px)\";}\nwindow.seek=function(t){T=t;\n  rev(id(\"kick\"),0.0,0.6);\n  rev(id(\"head\"),0.5,0.8);\n  rev(id(\"sub\"),1.6,0.7);\n  rev(id(\"stats\"),2.6,0.8,30);\n  rev(id(\"take\"),4.0,0.9);\n  rev(id(\"logo\"),5.2,0.6,20);\n  rev(id(\"tag\"),5.5,0.6,16);\n  rev(id(\"foot\"),5.8,0.6,16);};\nseek(0);\n</script>\n</body></html>\n",
