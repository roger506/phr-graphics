class=\"scene\" id=\"s5\">\n  <div class=\"li line\" id=\"s5a\"><span class=\"tick\">&#9656;</span> Land use change</div>\n  <div class=\"li line\" id=\"s5b\"><span class=\"tick\">&#9656;</span> Rezoning</div>\n  <div class=\"li line\" id=\"s5c\"><span class=\"tick\">&#9656;</span> Three variances</div>\n  <div class=\"li line\" id=\"s5d\"><span class=\"tick\">&#9656;</span> Site plan</div>\n</div>\n\n<div class=\"scene\" id=\"s6\">\n  <div class=\"big\">This is how a street gets <span class=\"gold\">repriced.</span></div>\n</div>\n\n<div class=\"scene\" id=\"s7\">\n  <div class=\"big\">I read the agendas <span class=\"gold\">so you do not have to.</span></div>\n</div>\n\n<div class=\"scene\" id=\"s8\">\n  <img class=\"endlogo\" src=\"../../assets/phr_logo_white.png\">\n  <div class=\"tagline\">Straight answers.<br><span class=\"gold\">Deep roots.</span></div>\n  <div class=\"endfoot\">Roger Averbuj, Broker | Prestige Heritage Realty | (954) 663-8461</div>\n</div>\n\n<script>\n  var SCENES = [\n    { id: 's1', start: 0.0,  end: 2.4 },\n    { id: 's2', start: 2.4,  end: 4.8 },\n    { id: 's3', start: 4.8,  end: 7.6 },\n    { id: 's4', start: 7.6,  end: 11.0 },\n    { id: 's5', start: 11.0, end: 14.2 },\n    { id: 's6', start: 14.2, end: 16.8 },\n    { id: 's7', start: 16.8, end: 19.6 },\n    { id: 's8', start: 19.6, end: 23.0 }\n  ];\n\n  function clamp01(x) { return Math.max(0, Math.min(1, x)); }\n  function easeOut(p) { return 1 - Math.pow(1 - p, 3); }\n\n  function setIn(el, t, sceneStart, delay, dur, rise) {\n    var p = clamp01((t - sceneStart - delay) / dur);\n    var e = easeOut(p);\n    el.style.opacity = e;\n    el.style.transform = 'translateY(' + ((1 - e) * (rise || 46)) + 'px)';\n  }\n\n  window.seek = function (t) {\n    for (var i = 0; i < SCENES.length; i++) {\n      var s = SCENES[i];\n      var el = document.getElementById(s.id);\n      if (t >= s.start && t < s.end) {\n        el.style.opacity = 1;\n        var p = clamp01((t - s.start) / 0.28);\n        var e = easeOut(p);\n        el.style.transform = 'translateY(' + ((1 - e) * 40) + 'px) scale(' + (0.985 + 0.015 * e) + ')';\n      } else {\n        el.style.opacity = 0;\n      }\n    }\n    var s2 = SCENES[1];\n    if (t >= s2.start && t < s2.end) {\n      setIn(document.getElementById('s2a'), t, s2.start, 0.0, 0.3);\n      setIn(document.getElementById('s2b'), t, s2.start, 0.75, 0.3);\n    }\n    var s4 = SCENES[3];\n    if (t >= s4.start && t < s4.end) {\n      setIn(document.getElementById('s4a'), t, s4.start, 0.9, 0.35);\n    }\n    var s5 = SCENES[4];\n    if (t >= s5.start && t < s5.end) {\n      setIn(document.getElementById('s5a'), t, s5.start, 0.0, 0.28);\n      setIn(document.getElementById('s5b'), t, s5.start, 0.65, 0.28);\n      setIn(document.getElementById('s5c'), t, s5.start, 1.3, 0.28);\n      setIn(document.getElementById('s5d'), t, s5.start, 1.95, 0.28);\n    }\n  };\n\n  seek(0);\n</script>\n</body>\n</html>\n",
