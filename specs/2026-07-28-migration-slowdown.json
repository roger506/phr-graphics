    "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n  html, body {\n    margin: 0; padding: 0;\n    width: 1080px; height: 1350px;\n    font-family: Georgia, 'Times New Roman', serif;\n    background: linear-gradient(160deg, #0d1f33 0%, #122c47 100%);\n    overflow: hidden;\n  }\n  .frame {\n    position: relative;\n    width: 1080px; height: 1350px;\n    box-sizing: border-box;\n    padding: 90px 80px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n  }\n  .kicker {\n    color: #c5a55a;\n    letter-spacing: 6px;\n    font-size: 28px;\n    text-transform: uppercase;\n    font-weight: bold;\n  }\n  .hook {\n    color: #ffffff;\n    font-size: 66px;\n    line-height: 1.28;\n    font-weight: bold;\n    margin-top: 40px;\n  }\n  .rule {\n    width: 140px;\n    height: 4px;\n    background: #c5a55a;\n    margin: 44px 0 36px 0;\n  }\n  .support {\n    color: #e7d9b8;\n    font-size: 32px;\n    line-height: 1.5;\n  }\n  .footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    border-top: 2px solid rgba(197,165,90,0.4);\n    padding-top: 34px;\n  }\n  .logo {\n    height: 64px;\n  }\n  .contact {\n    color: #ffffff;\n    font-size: 24px;\n    text-align: right;\n    line-height: 1.4;\n  }\n  .contact .name {\n    color: #c5a55a;\n    font-weight: bold;\n  }\n</style>\n</head>\n<body>\n  <div class=\"frame\">\n    <div>\n      <div class=\"kicker\">Broward Real Estate</div>\n      <div class=\"hook\">The migration wave just slowed down.</div>\n      <div class=\"rule\"></div>\n      <div class=\"support\">\n        Net migration to Florida fell from 1,640 new residents a day in 2022 to 551 a day in 2025.\n        Broward lost residents on net. Growth moved inland.\n      </div>\n    </div>\n    <div class=\"footer\">\n      <img class=\"logo\" src=\"../../assets/phr_logo_white.png\" alt=\"Prestige Heritage Realty\">\n      <div class=\"contact\">\n        <div class=\"name\">Roger Averbuj, Broker</div>\n        <div>Prestige Heritage Realty</div>\n        <div>(954) 663-8461</div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n",
