    "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n  html, body {\n    margin: 0; padding: 0;\n    width: 1080px; height: 1920px;\n    background: linear-gradient(160deg, #0d1f33 0%, #122c47 100%);\n    font-family: Georgia, 'Times New Roman', serif;\n    overflow: hidden;\n  }\n  .stage {\n    position: relative;\n    width: 1080px; height: 1920px;\n  }\n  .beat {\n    position: absolute;\n    left: 90px; right: 90px;\n    top: 50%;\n    transform: translateY(-50%) scale(0.94);\n    opacity: 0;\n    color: #ffffff;\n    font-size: 84px;\n    font-weight: bold;\n    line-height: 1.22;\n    text-align: left;\n  }\n  .beat .accent { color: #c5a55a; }\n  .beat.small { font-size: 66px; }\n  .endcard {\n    position: absolute;\n    left: 0; right: 0; top: 0; bottom: 0;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    opacity: 0;\n    text-align: center;\n  }\n  .endcard img { height: 120px; margin-bottom: 56px; }\n  .endcard .tagline {\n    color: #c5a55a;\n    font-size: 58px;\n    font-style: italic;\n    margin-bottom: 46px;\n  }\n  .endcard .footer {\n    color: #ffffff;\n    font-size: 34px;\n    line-height: 1.5;\n  }\n</style>\n</head>\n<body>\n  <div class=\"stage\">\n    <div class=\"beat\" id=\"b1\">EVERYONE SAID<br><span class=\"accent\">PEOPLE WOULD ALWAYS MOVE TO FLORIDA.</span></div>\n    <div class=\"beat\" id=\"b2\">NEW DATA SAYS<br><span class=\"accent\">OTHERWISE.</span></div>\n    <div class=\"beat\" id=\"b3\">1,640 NEW RESIDENTS A DAY IN 2022.<br><span class=\"accent\">551 A DAY IN 2025.</span></div>\n    <div class=\"beat\" id=\"b4\"><span class=\"accent\">BROWARD</span> LOST RESIDENTS<br>ON NET.</div>\n    <div class=\"beat small\" id=\"b5\">GROWTH MOVED INLAND.<br><span class=\"accent\">POLK. PASCO. MARION.</span></div>\n    <div class=\"beat small\" id=\"b6\">IN 23 YEARS,<br>I HAVE SEEN <span class=\"accent\">THIS TURN</span> BEFORE.</div>\n    <div class=\"beat\" id=\"b7\">PRICE FOR WHO IS<br><span class=\"accent\">ACTUALLY HERE.</span></div>\n    <div class=\"endcard\" id=\"end\">\n      <img src=\"../../assets/phr_logo_white.png\" alt=\"Prestige Heritage Realty\">\n      <div class=\"tagline\">Straight answers. Deep roots.</div>\n      <div class=\"footer\">\n        Roger Averbuj, Broker<br>\n        Prestige Heritage Realty<br>\n        (954) 663-8461\n      </div>\n    </div>\n  </div>\n\n<script>\n  // Beat schedule in seconds: [id, start, end]\n  var beats = [\n    [\"b1\", 0.0, 2.0],\n    [\"b2\", 2.0, 4.0],\n    [\"b3\", 4.0, 7.5],\n    [\"b4\", 7.5, 10.5],\n    [\"b5\", 10.5, 13.5],\n    [\"b6\", 13.5, 17.0],\n    [\"b7\", 17.0, 20.0]\n  ];\n  var endStart = 20.0;\n  var endEnd = 23.0;\n  var fadeDur = 0.35;\n\n  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }\n\n  function opacityFor(t, start, end) {\n    if (t < start || t > end) return 0;\n    var inFade = clamp((t - start) / fadeDur, 0, 1);\n    var outFade = clamp((end - t) / fadeDur, 0, 1);\n    return Math.min(inFade, outFade);\n  }\n\n  window.seek = function(t) {\n    for (var i = 0; i < beats.length; i++) {\n      var id = beats[i][0], start = beats[i][1], end = beats[i][2];\n      var el = document.getElementById(id);\n      var o = opacityFor(t, start, end);\n      el.style.opacity = o;\n      var scale = 0.94 + 0.06 * clamp(o, 0, 1);\n      el.style.transform = \"translateY(-50%) scale(\" + scale.toFixed(3) + \")\";\n    }\n    var endEl = document.getElementById(\"end\");\n    var eo = opacityFor(t, endStart, endEnd + fadeDur);\n    endEl.style.opacity = eo;\n  };\n\n  // Initialize at t=0\n  window.seek(0);\n</script>\n</body>\n</html>\n",
